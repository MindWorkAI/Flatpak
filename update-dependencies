#!/usr/bin/env bash
hash uv 2>/dev/null || { echo >&2 "error: uv not found"; exit 1; }
hash yq 2>/dev/null || { echo >&2 "error: yq not found"; exit 1; }
hash curl 2>/dev/null || { echo >&2 "error: curl not found"; exit 1; }

set -euo pipefail

FLATPAK_BUILDER_TOOLS_COMMIT="737c0085912f9f7dabf9341d4608e2a77a51a73a"
CARGO_GENERATOR_SHA256="b373c8ab1a05378ec5d8ed0645c7b127bcec7d2f7a1798694fbc627d570d856c"
BASE_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
REPO_TMP=$(mktemp -d -p "$BASE_DIR")
trap 'rm -rf "$REPO_TMP"' EXIT

verify_sha256() {
    local file="$1"
    local expected="$2"
    local actual

    if hash sha256sum 2>/dev/null; then
        actual=$(sha256sum "$file" | awk '{print $1}')
    elif hash shasum 2>/dev/null; then
        actual=$(shasum -a 256 "$file" | awk '{print $1}')
    else
        echo >&2 "error: neither sha256sum nor shasum was found"
        return 1
    fi

    if [ "$actual" != "$expected" ]; then
        echo >&2 "error: SHA-256 mismatch for '$file': expected '$expected', got '$actual'"
        return 1
    fi
}

download_generator() {
    local url="$1"
    local destination="$2"
    local expected_sha256="$3"

    if [ ! -f "$destination" ]; then
        local temporary_file
        temporary_file=$(mktemp "${destination}.tmp.XXXXXX")
        if ! curl -fsSL -o "$temporary_file" "$url" || \
           ! verify_sha256 "$temporary_file" "$expected_sha256"; then
            rm -f "$temporary_file"
            return 1
        fi
        mv "$temporary_file" "$destination"
    fi

    verify_sha256 "$destination" "$expected_sha256"
}

(
    cd "$BASE_DIR"

    echo -n "Preparing pinned flatpak-cargo-generator...  "
    download_generator \
        "https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/${FLATPAK_BUILDER_TOOLS_COMMIT}/cargo/flatpak-cargo-generator.py" \
        "flatpak-cargo-generator.py" \
        "$CARGO_GENERATOR_SHA256"
    echo "✅"

    repo=$(yq '(.modules[] | select(.name == "mind-work-ai-studio")).sources[0] | .url' org.mindworkai.AIStudio.yml)
    commit=$(yq '(.modules[] | select(.name == "mind-work-ai-studio")).sources[0] | .commit' org.mindworkai.AIStudio.yml)

    echo -n "Cloning $repo / $commit... "
    (
        cd "$REPO_TMP"
        git init
        git remote add origin "$repo"
        git fetch --depth 1 origin "$commit"
        git checkout FETCH_HEAD
    ) &> /dev/null
    echo "✅"

    # AI Studio ships the .NET runtime which line 5 of its metadata.txt names, e.g., "10.0.15 (commit
    # 8e0f8ed231)", whatever version the .NET extension of the SDK has: its project file sets
    # RuntimeFrameworkVersion from that line. The pipeline of AI Studio reads the line the same way:
    dotnet_runtime_version=$(sed -n '5p' "$REPO_TMP/metadata.txt" | sed 's/[^0-9.]*\([0-9.]*\).*/\1/')
    if ! [[ "$dotnet_runtime_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo >&2 "error: line 5 of metadata.txt names no .NET runtime version"
        exit 1
    fi
    echo "AI Studio ships the .NET runtime $dotnet_runtime_version"

    # Restoring AI Studio downloads the apphosts of all platforms in the version of its runtime, except
    # the apphost of the machine it runs on when the .NET SDK brings that one in the same version itself.
    # The build on the other Linux architecture needs it from the NuGet sources, though. Hence, we
    # download both Linux apphosts explicitly:
    mkdir "$REPO_TMP/linux-apphosts"
    cat > "$REPO_TMP/linux-apphosts/linux-apphosts.csproj" <<EOF
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <PackageDownload Include="Microsoft.NETCore.App.Host.linux-x64" Version="[${dotnet_runtime_version}]" />
        <PackageDownload Include="Microsoft.NETCore.App.Host.linux-arm64" Version="[${dotnet_runtime_version}]" />
    </ItemGroup>
</Project>
EOF

    uv run --with aiohttp flatpak-cargo-generator.py "$REPO_TMP/runtime/Cargo.lock" -o "cargo-sources.json"
    python3 flatpak-dotnet-generator.py -f 25.08 -d 10 "dotnet-sources.json" \
        "$REPO_TMP/app/Build/Build Script.csproj" \
        "$REPO_TMP/app/MindWork AI Studio/MindWork AI Studio.csproj" \
        "$REPO_TMP/app/SharedTools/SharedTools.csproj" \
        "$REPO_TMP/app/SourceCodeRules/SourceCodeRules/SourceCodeRules.csproj" \
        "$REPO_TMP/linux-apphosts/linux-apphosts.csproj" --dotnet-args --no-cache

    # The Flatpak ships what dotnet-sources.json lists: the runtime, the apphost, and the script of Blazor
    # have to be the ones of metadata.txt, for both Linux architectures, and no other runtime may be there.
    # Otherwise, the Flatpak would ship another runtime than all other builds of AI Studio, without a word:
    nuget_files=$(yq -r '.[]."dest-filename"' dotnet-sources.json)
    expected_files=("microsoft.aspnetcore.app.internal.assets.${dotnet_runtime_version}.nupkg")
    for package in microsoft.netcore.app.runtime microsoft.aspnetcore.app.runtime microsoft.netcore.app.host; do
        for rid in linux-x64 linux-arm64; do
            expected_files+=("${package}.${rid}.${dotnet_runtime_version}.nupkg")
        done
    done

    missing_files=""
    for expected_file in "${expected_files[@]}"; do
        grep -qxF "$expected_file" <<< "$nuget_files" || missing_files+="  $expected_file"$'\n'
    done

    other_runtime_files=$(grep -E '^microsoft\.(netcore|aspnetcore)\.app\.runtime\.' <<< "$nuget_files" | grep -vF ".${dotnet_runtime_version}.nupkg" || true)
    if [ -n "$missing_files" ] || [ -n "$other_runtime_files" ]; then
        echo >&2 "error: dotnet-sources.json does not hold the .NET runtime $dotnet_runtime_version of AI Studio"
        [ -z "$missing_files" ] || echo >&2 -n "missing:"$'\n'"$missing_files"
        [ -z "$other_runtime_files" ] || echo >&2 "runtime packs of another version:"$'\n'"$other_runtime_files"
        echo >&2 "Does the project file of AI Studio still set RuntimeFrameworkVersion from line 5 of metadata.txt?"
        exit 1
    fi
    echo "dotnet-sources.json holds the .NET runtime $dotnet_runtime_version ✅"

    # AI Studio builds with the Rust toolchain which line 6 of its metadata.txt names, e.g., "1.100.0 (commit
    # 0ef1bc386)", like all its other builds. The manifest of that Rust release names the archives and their
    # checksums, and update-rust-toolchain.py checks that it describes the very toolchain of that line:
    rust_toolchain=$(sed -n '6p' "$REPO_TMP/metadata.txt")
    rust_version=$(python3 update-rust-toolchain.py version "$rust_toolchain")
    curl -fsSL -o "$REPO_TMP/channel-rust.toml" "https://static.rust-lang.org/dist/channel-rust-${rust_version}.toml"
    rust_archives=$(python3 update-rust-toolchain.py archives "$rust_toolchain" "$REPO_TMP/channel-rust.toml")
    while read -r architecture url sha256; do
        ARCHITECTURE="$architecture" URL="$url" SHA256="$sha256" yq -i '
            (.modules[] | select(.name == "rust-toolchain").sources[] | select(.only-arches[0] == strenv(ARCHITECTURE)).url) = strenv(URL) |
            (.modules[] | select(.name == "rust-toolchain").sources[] | select(.only-arches[0] == strenv(ARCHITECTURE)).sha256) = strenv(SHA256)
        ' org.mindworkai.AIStudio.yml

        # yq changes nothing when no source matches, so we read back what it wrote:
        written=$(ARCHITECTURE="$architecture" yq -r '.modules[] | select(.name == "rust-toolchain").sources[] | select(.only-arches[0] == strenv(ARCHITECTURE)) | .url + " " + .sha256' org.mindworkai.AIStudio.yml)
        if [ "$written" != "$url $sha256" ]; then
            echo >&2 "error: the module rust-toolchain of the manifest has no archive for $architecture"
            exit 1
        fi
    done <<< "$rust_archives"
    echo "AI Studio builds with Rust $rust_toolchain ✅"

    find "$REPO_TMP" -mindepth 1 -delete

    repo=$(yq '(.modules[] | select(.name == "tauri-cli")).sources[0] | .url' org.mindworkai.AIStudio.yml)
    commit=$(yq '(.modules[] | select(.name == "tauri-cli")).sources[0] | .tag' org.mindworkai.AIStudio.yml)

    echo -n "Cloning $repo / $commit... "
    (
        cd "$REPO_TMP"
        git init
        git remote add origin "$repo"
        git fetch --depth 1 origin "$commit"
        git checkout FETCH_HEAD
    ) &> /dev/null
    echo "✅"

    uv run --with aiohttp flatpak-cargo-generator.py "$REPO_TMP/Cargo.lock" -o "tauri-cli-sources.json"

    for generated_source in cargo-sources.json dotnet-sources.json tauri-cli-sources.json; do
        source_count=$(yq 'length' "$generated_source")
        if [ "$source_count" -le 0 ]; then
            echo >&2 "error: '$generated_source' does not contain any generated sources"
            exit 1
        fi
    done
)
